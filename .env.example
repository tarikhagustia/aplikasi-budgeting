# ── Konfigurasi Aplikasi ─────────────────────────────
# PIN untuk membuka aplikasi (default: 123456)
APP_PIN=123456

# API key untuk MCP server mode HTTP (header: x-mcp-key)
# Kalau kosong, MCP pakai APP_PIN sebagai key
MCP_API_KEY=

# Lokasi file database SQLite (default: ./money_management.db)
# MONEY_DB_PATH=./money_management.db
